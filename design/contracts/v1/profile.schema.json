{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-editor:schema:profile:1",
  "type": "object",
  "properties": {
    "format": {
      "const": "circuit-design-profile"
    },
    "formatVersion": {
      "const": 1
    },
    "status": {
      "const": "proposed-not-implemented"
    },
    "modelSet": {
      "type": "object",
      "properties": {
        "id": {
          "const": "core.dc"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "deviceObservables": {
      "type": "object",
      "properties": {
        "dcSupply": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxProperties": 32,
          "additionalProperties": {
            "enum": [
              "boolean"
            ]
          }
        },
        "pushButton": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxProperties": 32,
          "additionalProperties": {
            "enum": [
              "boolean"
            ]
          }
        },
        "relay": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxProperties": 32,
          "additionalProperties": {
            "enum": [
              "boolean"
            ]
          }
        },
        "lamp": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxProperties": 32,
          "additionalProperties": {
            "enum": [
              "boolean"
            ]
          }
        }
      },
      "required": [
        "dcSupply",
        "pushButton",
        "relay",
        "lamp"
      ],
      "additionalProperties": false
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^core\\.[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$",
            "maxLength": 96
          },
          "version": {
            "const": 1
          },
          "deviceKind": {
            "enum": [
              "dcSupply",
              "pushButton",
              "relay",
              "lamp"
            ]
          },
          "role": {
            "enum": [
              "controller",
              "observer"
            ]
          },
          "domain": {
            "const": "electrical.dc"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "role": {
                  "enum": [
                    "positive",
                    "return",
                    "load",
                    "switched"
                  ]
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "defaultMarking": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "id",
                "role",
                "anchor",
                "defaultMarking"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "press",
                "release"
              ]
            },
            "minItems": 0,
            "maxItems": 2
          },
          "observables": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "maxProperties": 32,
            "additionalProperties": {
              "enum": [
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "version",
          "deviceKind",
          "role",
          "domain",
          "ports",
          "actions",
          "observables"
        ],
        "additionalProperties": false
      },
      "minItems": 7,
      "maxItems": 7
    }
  },
  "required": [
    "format",
    "formatVersion",
    "status",
    "modelSet",
    "deviceObservables",
    "definitions"
  ],
  "additionalProperties": false
}
